# --- Servidor ---
PORT=3001
NODE_ENV=development
PUBLIC_BASE_URL=https://tu-dominio-dev.example.com

# --- Base de datos ---
DATABASE_URL=postgres://usuario:password@localhost:5432/voz_ia

# --- Twilio (cuenta del cliente) ---
# Nunca commitear valores reales. En prod, estas credenciales viven encriptadas
# por empresa en la tabla `empresas`, no solo en env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Servidor de voz IA ---
VOICE_WS_URL=wss://tu-dominio-dev.example.com/voice-stream

# --- LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Storage (Cloudflare R2 / S3) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
