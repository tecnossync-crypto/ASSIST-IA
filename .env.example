# --- Servidor ---
# backend y voice-server son procesos separados; si corres ambos en local
# desde este mismo .env, usa PORT para backend y VOICE_SERVER_PORT para el otro.
PORT=3001
VOICE_SERVER_PORT=3002
NODE_ENV=development
PUBLIC_BASE_URL=https://tu-dominio-dev.example.com

# --- Base de datos ---
DATABASE_URL=postgres://usuario:password@localhost:5432/voz_ia

# --- Twilio (cuenta del cliente) ---
# Nunca commitear valores reales. Se usan para el seed inicial de la empresa;
# en la tabla `empresas` el auth_token queda encriptado con ENCRYPTION_KEY,
# no en texto plano.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Clave para encriptar credenciales sensibles en la base (ej. twilio_auth_token).
# Generar con: openssl rand -hex 32 — y NUNCA rotarla sin re-encriptar los datos existentes.
ENCRYPTION_KEY=

# --- Servidor de voz IA ---
VOICE_WS_URL=wss://tu-dominio-dev.example.com/voice-stream

# --- Comunicación interna backend <-> voice-server ---
# Mismo valor en ambos servicios. Generar con: openssl rand -hex 32
INTERNAL_API_KEY=
BACKEND_INTERNAL_URL=http://localhost:3001

# --- LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Seed de la primera empresa (usado solo por `npm run seed` en backend) ---
SEED_EMPRESA_NOMBRE=
SEED_GUION_SALUDO=
SEED_GUION_QUE_RESUELVE=
SEED_GUION_DATOS_A_TOMAR=nombre,telefono,motivo
SEED_GUION_CUANDO_TRANSFERIR=
SEED_NUMEROS_TRANSFERENCIA=

# --- Storage (Cloudflare R2 / S3) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
