{$PUBLIC_DOMAIN} {
	# ConversationRelay conecta acá por WebSocket.
	handle /voice-stream* {
		reverse_proxy voice-server:3002
	}

	# Audio en vivo para Supervisión (llamadas de IA) — Twilio manda el
	# audio crudo, y el navegador del admin se conecta acá mismo a
	# escucharlo. Ver voice-server/src/supervision-stream.ts.
	handle /supervision-stream* {
		reverse_proxy voice-server:3002
	}

	# Audio temporal de voces clonadas (ElevenLabs) — Twilio lo descarga acá
	# justo cuando le mandamos un mensaje "play" por ConversationRelay. Ver
	# voice-server/src/server.ts (audioTemporalUrl / GET /tts-audio/:id).
	handle /tts-audio* {
		reverse_proxy voice-server:3002
	}

	# La extensión de Chrome abre /extension-panel, que es del DASHBOARD. Si se
	# configuró con este dominio (el de la API/webhooks) en vez del del
	# dashboard, el backend respondía "Route GET:/extension-panel not found":
	# se manda al dominio correcto para que funcione sin reinstalar nada.
	handle /extension-panel* {
		redir https://{$DASHBOARD_DOMAIN}{uri} 302
	}

	# Todo lo demás (webhooks de Twilio, /internal, /api, /health) va al backend.
	handle {
		reverse_proxy backend:3001
	}
}

{$DASHBOARD_DOMAIN} {
	reverse_proxy dashboard:3000
}

# ---------------------------------------------------------------------------
# Ambiente de QA (mismo servidor): sus contenedores están en otra "compose"
# (docker-compose.qa.yml) pero comparten la red de este Caddy, así que se les
# llega por nombre. Si QA no está levantado, estos dominios solo darán 502 y
# producción no se entera. Ver docs/entornos-qa-produccion.md.
# ---------------------------------------------------------------------------
{$QA_PUBLIC_DOMAIN} {
	handle /voice-stream* {
		reverse_proxy qa-voice-server:3002
	}

	handle /supervision-stream* {
		reverse_proxy qa-voice-server:3002
	}

	handle /tts-audio* {
		reverse_proxy qa-voice-server:3002
	}

	handle /extension-panel* {
		redir https://{$QA_DASHBOARD_DOMAIN}{uri} 302
	}

	handle {
		reverse_proxy qa-backend:3001
	}
}

{$QA_DASHBOARD_DOMAIN} {
	reverse_proxy qa-dashboard:3000
}
